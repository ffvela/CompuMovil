---
// ─────────────────────────────────────────────────────────────────
// Hero.astro — Portada. Responde "¿Qué es la carrera?".
// Muestra el nombre oficial, una bajada, los datos clave (título,
// grado, duración, jornada...) y los llamados a la acción.
// Contiene el ÚNICO <h1> de la página.
// ─────────────────────────────────────────────────────────────────
import { getCollection, type CollectionEntry } from 'astro:content';
import Cita from './Cita.astro';

// La colección "carrera" tiene un solo elemento.
const [carrera]: CollectionEntry<'carrera'>[] = await getCollection('carrera');
if (!carrera) throw new Error('Falta src/content/carrera.json');
const { nombre, universidad, bajada, datos, aviso, avisoCita } = carrera.data;

// Juntamos las fuentes de todos los datos clave, sin repetir.
const citasDatos: string[] = [...new Set(datos.map((d) => d.cita))];
---

<section id="inicio" class="hero" aria-labelledby="titulo-principal">
  <div class="contenedor hero__grid">
    <div class="hero__texto">
      <p class="hero__kicker">{universidad}</p>
      <h1 id="titulo-principal">{nombre}</h1>
      <p class="hero__bajada">{bajada} <Cita ids={citasDatos} /></p>

      <!-- Son enlaces (<a>) y no botones porque navegan a otra parte
           de la página; un <button> se usa para acciones. -->
      <div class="hero__acciones">
        <a class="boton boton--primario" href="#admision">Cómo postular</a>
        <a class="boton boton--secundario" href="#malla">Ver la malla</a>
      </div>

      <p class="hero__aviso">
        <span aria-hidden="true">📅 </span>{aviso} <Cita ids={[avisoCita]} />
      </p>
    </div>

    <!-- <dl> porque cada dato es un par etiqueta-valor (WCAG 1.3.1). -->
    <dl class="hero__datos">
      {
        datos.map((d) => (
          <div class="dato">
            <dt>{d.etiqueta}</dt>
            <dd>{d.valor}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
